# Database backend: sqlite (default) or mongo
DB_BACKEND=sqlite

# Mongo settings (used when DB_BACKEND=mongo)
ATLAS_URI=mongodb://localhost:27017
RACE_DB_NAME=j5_racing
LAPS_COLLECTION=laps_live

# SQLite settings (used when DB_BACKEND=sqlite)
SQLITE_PATH=apps/racemanager/service/data/race_manager.db

WS_PUBLIC_URL=ws://localhost:4000/ws
HTTP_HOST=0.0.0.0
HTTP_PORT=4000
